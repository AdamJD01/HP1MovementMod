class SpellFireFX expands ParticleFX;

defaultproperties
{
     ParticlesPerSec=(Base=40,Rand=5)
     SourceWidth=(Base=8)
     SourceHeight=(Base=8)
     SourceDepth=(Base=4)
     SizeWidth=(Base=10)
     SizeLength=(Base=10)
     SizeEndScale=(Base=1.1,Rand=0.6)
     DripTime=(Base=0.25)
     Gravity=(Z=-200)
}
