//=============================================================================
// SpellDrawFX.
//=============================================================================
class SpellDrawFX expands ParticleFX;

defaultproperties
{
     ParticlesPerSec=(Base=2)
     SourceWidth=(Base=0)
     SourceHeight=(Base=0)
     AngularSpreadWidth=(Base=0)
     AngularSpreadHeight=(Base=0)
     Speed=(Base=0)
     Lifetime=(Base=2)
     ColorStart=(Base=(G=0))
     ColorEnd=(Base=(R=128,B=64))
     AlphaDelay=5
     ColorDelay=5
     Distribution=DIST_Uniform
}
